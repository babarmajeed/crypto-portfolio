// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String   @id @default(cuid())
  email                 String   @unique
  firstName             String
  lastName              String
  password              String
  isEmailVerified       Boolean  @default(false)
  emailVerificationToken String?
  emailVerificationExpires DateTime?
  passwordResetToken    String?
  passwordResetExpires  DateTime?
  lastLogin             DateTime?
  failedLoginAttempts   Int      @default(0)
  accountLockedUntil    DateTime?
  role                  UserRole @default(BASIC)
  isActive              Boolean  @default(true)
  isTwoFactorEnabled    Boolean  @default(false)
  twoFactorSecret       String?
  backupCodes           String[] @default([])
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  // Relationships
  portfolios            Portfolio[]
  transactions          Transaction[]
  priceAlerts           PriceAlert[]
  profile               UserProfile?
  preferences           UserPreferences?
  refreshTokens         RefreshToken[]
  oauthAccounts         OAuthAccount[]
  auditLogs             AuditLog[]
  loginSessions         LoginSession[]
  trustedDevices        TrustedDevice[]
  exchangeCredentials   UserExchangeCredential[]
  encryptedCredentials  EncryptedApiCredential[]
  keyAuditLogs          KeyAuditLog[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  isRevoked Boolean  @default(false)
  deviceInfo String?
  ipAddress String?
  createdAt DateTime @default(now())

  @@map("refresh_tokens")
}

model OAuthAccount {
  id           String @id @default(cuid())
  userId       String
  user         User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider     String
  providerAccountId String
  accessToken  String?
  refreshToken String?
  expiresAt    DateTime?
  tokenType    String?
  scope        String?
  idToken      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([provider, providerAccountId])
  @@map("oauth_accounts")
}

model LoginSession {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId  String    @unique
  ipAddress  String
  userAgent  String?
  deviceInfo String?
  loginAt    DateTime  @default(now())
  logoutAt   DateTime?
  isActive   Boolean   @default(true)
  expiresAt  DateTime

  @@map("login_sessions")
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  action     String   @db.VarChar(100)
  resource   String?  @db.VarChar(100)
  resourceId String?  @map("resource_id") @db.VarChar(100)
  oldValues  Json?    @map("old_values")
  newValues  Json?    @map("new_values")
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@map("audit_logs")
}

model TrustedDevice {
  id                String   @id @default(cuid())
  userId            String   @map("user_id")
  deviceFingerprint String   @map("device_fingerprint") @db.VarChar(500)
  deviceName        String?  @map("device_name") @db.VarChar(200)
  lastSeen          DateTime @default(now()) @map("last_seen")
  trustedAt         DateTime @default(now()) @map("trusted_at")
  createdAt         DateTime @default(now()) @map("created_at")
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([userId, deviceFingerprint])
  @@map("trusted_devices")
}

model RateLimitEntry {
  id        String   @id @default(cuid())
  key       String   @unique
  attempts  Int      @default(1)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("rate_limit_entries")
}

model UserProfile {
  id        String   @id @default(cuid())
  userId    String   @unique @map("user_id")
  firstName String?  @map("first_name") @db.VarChar(100)
  lastName  String?  @map("last_name") @db.VarChar(100)
  avatarUrl String?  @map("avatar_url") @db.VarChar(500)
  timezone  String   @default("UTC") @db.VarChar(50)
  language  String   @default("en") @db.VarChar(10)
  country   String?  @db.VarChar(5)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@map("user_profiles")
}

model UserPreferences {
  id              String   @id @default(cuid())
  userId          String   @unique @map("user_id")
  baseCurrency    String   @default("USD") @map("base_currency") @db.VarChar(10)
  theme           String   @default("light") @db.VarChar(20)
  dashboardLayout Json     @default("{}") @map("dashboard_layout")
  notifications   Json     @default("{\"email\": true, \"push\": true, \"sms\": false}")
  privacySettings Json     @default("{\"portfolio_public\": false}") @map("privacy_settings")
  riskTolerance   String   @default("moderate") @map("risk_tolerance") @db.VarChar(20)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@map("user_preferences")
}

// Exchange and Trading Infrastructure
model Exchange {
  id                String             @id @default(cuid())
  name              String             @unique
  displayName       String             @map("display_name")
  websiteUrl        String?            @map("website_url")
  apiBaseUrl        String             @map("api_base_url")
  websocketUrl      String?            @map("websocket_url")
  rateLimitPerMinute Int               @default(1200) @map("rate_limit_per_minute")
  requiresKyc       Boolean            @default(false) @map("requires_kyc")
  supportedCountries String[]          @map("supported_countries")
  tradingFees       Json               @default("{}") @map("trading_fees")
  status            ExchangeStatus     @default(ACTIVE)
  isActive          Boolean            @default(true) @map("is_active")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  
  // Relations
  encryptedCredentials EncryptedApiCredential[]
  tradingPairs     TradingPair[]
  portfolios       Portfolio[]
  holdings         Holding[]
  transactions     Transaction[]
  
  @@map("exchanges")
}

model UserExchangeCredential {
  id                 String       @id @default(cuid())
  userId             String       @map("user_id")
  exchange           String       @default("binance")
  apiKey             String       @map("api_key")
  apiSecret          String       @map("api_secret")
  passphrase         String?      @map("passphrase")
  sandboxMode        Boolean      @default(false) @map("sandbox_mode")
  permissions        String[]     @default(["read"])
  lastSync           DateTime?    @map("last_sync")
  syncStatus         String       @default("pending") @map("sync_status")
  errorMessage       String?      @map("error_message")
  isActive           Boolean      @default(true) @map("is_active")
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")
  
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([userId, exchange])
  @@map("user_exchange_credentials")
}

// Cryptocurrency and Market Data
model Cryptocurrency {
  id                String            @id @default(cuid())
  symbol            String            @unique
  name              String
  coingeckoId       String?           @map("coingecko_id")
  coinmarketcapId   Int?              @map("coinmarketcap_id")
  description       String?
  logoUrl           String?           @map("logo_url")
  websiteUrl        String?           @map("website_url")
  whitepaperUrl     String?           @map("whitepaper_url")
  maxSupply         Decimal?          @map("max_supply") @db.Decimal(30, 8)
  circulatingSupply Decimal?          @map("circulating_supply") @db.Decimal(30, 8)
  marketCapRank     Int?              @map("market_cap_rank")
  isActive          Boolean           @default(true) @map("is_active")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")
  
  // Relations
  baseTradingPairs  TradingPair[]     @relation("BaseCurrency")
  quoteTradingPairs TradingPair[]     @relation("QuoteCurrency")
  holdings          Holding[]
  transactions      Transaction[]
  priceAlerts       PriceAlert[]
  priceHistory      PriceHistory[]
  currentPrices     CurrentPrice[]
  
  @@map("cryptocurrencies")
}

model TradingPair {
  id                String           @id @default(cuid())
  exchangeId        String           @map("exchange_id")
  baseCurrencyId    String           @map("base_currency_id")
  quoteCurrencyId   String           @map("quote_currency_id")
  symbol            String
  minOrderSize      Decimal?         @map("min_order_size") @db.Decimal(30, 8)
  maxOrderSize      Decimal?         @map("max_order_size") @db.Decimal(30, 8)
  pricePrecision    Int              @default(8) @map("price_precision")
  quantityPrecision Int              @default(8) @map("quantity_precision")
  isActive          Boolean          @default(true) @map("is_active")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")
  
  exchange         Exchange         @relation(fields: [exchangeId], references: [id])
  baseCurrency     Cryptocurrency   @relation("BaseCurrency", fields: [baseCurrencyId], references: [id])
  quoteCurrency    Cryptocurrency   @relation("QuoteCurrency", fields: [quoteCurrencyId], references: [id])
  priceHistory     PriceHistory[]
  currentPrice     CurrentPrice?
  
  @@unique([exchangeId, symbol])
  @@map("trading_pairs")
}

// Price Data Models
model PriceHistory {
  id              String          @id @default(cuid())
  tradingPairId   String?         @map("trading_pair_id")
  cryptocurrencyId String?        @map("cryptocurrency_id")
  price           Decimal         @db.Decimal(30, 8)
  volume24h       Decimal?        @map("volume_24h") @db.Decimal(30, 8)
  marketCap       Decimal?        @map("market_cap") @db.Decimal(30, 8)
  change24h       Decimal?        @map("change_24h") @db.Decimal(10, 4)
  timestamp       DateTime
  source          String
  
  tradingPair     TradingPair?    @relation(fields: [tradingPairId], references: [id])
  cryptocurrency  Cryptocurrency? @relation(fields: [cryptocurrencyId], references: [id])
  
  @@index([tradingPairId, timestamp])
  @@index([cryptocurrencyId, timestamp])
  @@map("price_history")
}

model CurrentPrice {
  id              String       @id @default(cuid())
  tradingPairId   String       @unique @map("trading_pair_id")
  cryptocurrencyId String?     @map("cryptocurrency_id")
  price           Decimal      @db.Decimal(30, 8)
  change24h       Decimal?     @map("change_24h") @db.Decimal(10, 4)
  volume24h       Decimal?     @map("volume_24h") @db.Decimal(30, 8)
  marketCap       Decimal?     @map("market_cap") @db.Decimal(30, 8)
  lastUpdated     DateTime     @default(now()) @map("last_updated")
  
  tradingPair     TradingPair  @relation(fields: [tradingPairId], references: [id])
  cryptocurrency  Cryptocurrency? @relation(fields: [cryptocurrencyId], references: [id])
  
  @@map("current_prices")
}

// Portfolio Management
model Portfolio {
  id          String        @id @default(cuid())
  userId      String        @map("user_id")
  exchangeId  String?       @map("exchange_id")
  name        String
  description String?
  type        PortfolioType @default(MAIN)
  isDefault   Boolean       @default(false) @map("is_default")
  isActive    Boolean       @default(true) @map("is_active")
  totalValue  Decimal?      @default(0) @map("total_value") @db.Decimal(30, 8)
  totalCost   Decimal?      @default(0) @map("total_cost") @db.Decimal(30, 8)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  
  user               User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  exchange           Exchange?             @relation(fields: [exchangeId], references: [id])
  holdings           Holding[]
  transactions       Transaction[]
  portfolioSnapshots PortfolioSnapshot[]
  performanceMetrics PerformanceMetric[]
  
  @@map("portfolios")
}

model Holding {
  id               String         @id @default(cuid())
  portfolioId      String         @map("portfolio_id")
  cryptocurrencyId String         @map("cryptocurrency_id")
  exchangeId       String?        @map("exchange_id")
  quantity         Decimal        @default(0) @db.Decimal(30, 8)
  averageCost      Decimal?       @map("average_cost") @db.Decimal(30, 8)
  totalCost        Decimal?       @map("total_cost") @db.Decimal(30, 8)
  currentValue     Decimal?       @map("current_value") @db.Decimal(30, 8)
  unrealizedPnl    Decimal?       @map("unrealized_pnl") @db.Decimal(30, 8)
  lastSync         DateTime       @default(now()) @map("last_sync")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")
  
  portfolio      Portfolio      @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  cryptocurrency Cryptocurrency @relation(fields: [cryptocurrencyId], references: [id])
  exchange       Exchange?      @relation(fields: [exchangeId], references: [id])
  
  @@unique([portfolioId, cryptocurrencyId, exchangeId])
  @@map("holdings")
}

model Transaction {
  id                     String             @id @default(cuid())
  userId                 String             @map("user_id")
  portfolioId            String             @map("portfolio_id")
  exchangeId             String?            @map("exchange_id")
  exchangeTransactionId  String?            @map("exchange_transaction_id")
  type                   TransactionType
  status                 TransactionStatus  @default(COMPLETED)
  cryptocurrencyId       String             @map("cryptocurrency_id")
  quantity               Decimal            @db.Decimal(30, 8)
  price                  Decimal?           @db.Decimal(30, 8)
  fee                    Decimal            @default(0) @db.Decimal(30, 8)
  feeCurrencyId          String?            @map("fee_currency_id")
  totalValue             Decimal?           @map("total_value") @db.Decimal(30, 8)
  notes                  String?
  transactionHash        String?            @map("transaction_hash")
  blockNumber            BigInt?            @map("block_number")
  executedAt             DateTime           @map("executed_at")
  createdAt              DateTime           @default(now()) @map("created_at")
  updatedAt              DateTime           @updatedAt @map("updated_at")
  
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  portfolio      Portfolio      @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  exchange       Exchange?      @relation(fields: [exchangeId], references: [id])
  cryptocurrency Cryptocurrency @relation(fields: [cryptocurrencyId], references: [id])
  
  @@index([userId, executedAt])
  @@index([portfolioId, executedAt])
  @@map("transactions")
}

model PriceAlert {
  id               String         @id @default(cuid())
  userId           String         @map("user_id")
  cryptocurrencyId String         @map("cryptocurrency_id")
  type             AlertType
  targetPrice      Decimal        @map("target_price") @db.Decimal(30, 8)
  currentPrice     Decimal?       @map("current_price") @db.Decimal(30, 8)
  isActive         Boolean        @default(true) @map("is_active")
  triggeredAt      DateTime?      @map("triggered_at")
  notificationSent Boolean        @default(false) @map("notification_sent")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")
  
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  cryptocurrency Cryptocurrency @relation(fields: [cryptocurrencyId], references: [id])
  
  @@map("price_alerts")
}

// Analytics and Performance
model PortfolioSnapshot {
  id              String    @id @default(cuid())
  portfolioId     String    @map("portfolio_id")
  totalValue      Decimal   @map("total_value") @db.Decimal(30, 8)
  totalCost       Decimal   @map("total_cost") @db.Decimal(30, 8)
  unrealizedPnl   Decimal   @map("unrealized_pnl") @db.Decimal(30, 8)
  realizedPnl     Decimal   @map("realized_pnl") @db.Decimal(30, 8)
  roiPercentage   Decimal?  @map("roi_percentage") @db.Decimal(10, 4)
  snapshotDate    DateTime  @map("snapshot_date")
  createdAt       DateTime  @default(now()) @map("created_at")
  
  portfolio Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  
  @@unique([portfolioId, snapshotDate])
  @@map("portfolio_snapshots")
}

model PerformanceMetric {
  id                String    @id @default(cuid())
  portfolioId       String    @map("portfolio_id")
  period            String    // '1d', '7d', '30d', '1y', 'all'
  returnPercentage  Decimal?  @map("return_percentage") @db.Decimal(10, 4)
  volatility        Decimal?  @db.Decimal(10, 4)
  sharpeRatio       Decimal?  @map("sharpe_ratio") @db.Decimal(10, 4)
  maxDrawdown       Decimal?  @map("max_drawdown") @db.Decimal(10, 4)
  alpha             Decimal?  @db.Decimal(10, 4)
  beta              Decimal?  @db.Decimal(10, 4)
  calculatedAt      DateTime  @default(now()) @map("calculated_at")
  
  portfolio Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  
  @@unique([portfolioId, period])
  @@map("performance_metrics")
}

// Enums
enum ExchangeStatus {
  ACTIVE
  INACTIVE
  ERROR
  RATE_LIMITED
}

enum PortfolioType {
  MAIN
  TRADING
  SAVINGS
  DEFI
}

enum TransactionType {
  BUY
  SELL
  DEPOSIT
  WITHDRAWAL
  TRANSFER
  STAKING_REWARD
  AIRDROP
  FORK
  MINING
  FEE
  DIVIDEND
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
}

enum AlertType {
  ABOVE
  BELOW
  PERCENTAGE_CHANGE
}

enum UserRole {
  BASIC
  PREMIUM
  ADMIN
}

// ==================================
// SECURITY AND ENCRYPTION MODELS
// ==================================

// Master encryption keys for envelope encryption
model MasterKey {
  id                String            @id @default(cuid())
  keyId             String            @unique @map("key_id") @db.VarChar(100)
  version           Int               @default(1)
  encryptedKey      String            @map("encrypted_key") @db.Text
  keyDerivationSalt String            @map("key_derivation_salt") @db.VarChar(100)
  algorithm         String            @default("AES-256-GCM") @db.VarChar(50)
  keyType           MasterKeyType     @default(USER_DATA) @map("key_type")
  status            MasterKeyStatus   @default(ACTIVE)
  rotationPeriod    Int               @default(7776000) @map("rotation_period") // 90 days in seconds
  lastRotated       DateTime?         @map("last_rotated")
  nextRotation      DateTime          @map("next_rotation")
  createdBy         String            @map("created_by")
  isActive          Boolean           @default(true) @map("is_active")
  hsmBacked         Boolean           @default(false) @map("hsm_backed")
  metadata          Json              @default("{}")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")
  
  // Relations
  dataKeys          DataKey[]
  rotationHistory   KeyRotationHistory[]
  auditLogs         KeyAuditLog[]
  
  @@index([status, isActive])
  @@index([nextRotation])
  @@map("master_keys")
}

// Data encryption keys (envelope encryption)
model DataKey {
  id                    String       @id @default(cuid())
  masterKeyId           String       @map("master_key_id")
  dataKeyId             String       @unique @map("data_key_id") @db.VarChar(100)
  encryptedDataKey      String       @map("encrypted_data_key") @db.Text
  keyContext            Json         @default("{}") @map("key_context")
  algorithm             String       @default("AES-256-GCM") @db.VarChar(50)
  keyPurpose            DataKeyPurpose
  associatedResourceId  String?      @map("associated_resource_id") @db.VarChar(100)
  createdAt             DateTime     @default(now()) @map("created_at")
  usageCount            Int          @default(0) @map("usage_count")
  lastUsed              DateTime?    @map("last_used")
  expiresAt             DateTime?    @map("expires_at")
  isActive              Boolean      @default(true) @map("is_active")
  
  masterKey             MasterKey    @relation(fields: [masterKeyId], references: [id], onDelete: Cascade)
  
  // Relations
  apiCredentials        EncryptedApiCredential[]
  
  @@index([masterKeyId, isActive])
  @@index([keyPurpose, associatedResourceId])
  @@index([expiresAt])
  @@map("data_keys")
}

// Enhanced encrypted API credentials with envelope encryption
model EncryptedApiCredential {
  id                        String                    @id @default(cuid())
  userId                    String                    @map("user_id")
  exchangeId                String?                   @map("exchange_id")
  dataKeyId                 String                    @map("data_key_id")
  credentialId              String                    @unique @map("credential_id") @db.VarChar(100)
  encryptedApiKey           String                    @map("encrypted_api_key") @db.Text
  encryptedApiSecret        String                    @map("encrypted_api_secret") @db.Text
  encryptedPassphrase       String?                   @map("encrypted_passphrase") @db.Text
  apiKeyHash                String                    @map("api_key_hash") @db.VarChar(128)
  encryptionMetadata        Json                      @map("encryption_metadata") @default("{}")
  permissions               String[]                  @default(["read"])
  permissionHash            String                    @map("permission_hash") @db.VarChar(128)
  lastValidated             DateTime?                 @map("last_validated")
  validationStatus          KeyValidationStatus       @default(PENDING) @map("validation_status")
  validationError           String?                   @map("validation_error") @db.Text
  riskScore                 Decimal                   @default(0) @map("risk_score") @db.Decimal(3, 2)
  securityLevel             SecurityLevel             @default(STANDARD) @map("security_level")
  ipWhitelist               String[]                  @default([]) @map("ip_whitelist")
  geographicRestrictions    String[]                  @default([]) @map("geographic_restrictions")
  usageMetrics              Json                      @default("{}") @map("usage_metrics")
  lastSync                  DateTime?                 @map("last_sync")
  syncStatus                String                    @default("pending") @map("sync_status")
  errorMessage              String?                   @map("error_message") @db.Text
  rotationPeriod            Int                       @default(2592000) @map("rotation_period") // 30 days
  nextRotation              DateTime?                 @map("next_rotation")
  isActive                  Boolean                   @default(true) @map("is_active")
  sandboxMode               Boolean                   @default(false) @map("sandbox_mode")
  emergencyRevoked          Boolean                   @default(false) @map("emergency_revoked")
  revokedAt                 DateTime?                 @map("revoked_at")
  revokedBy                 String?                   @map("revoked_by")
  revocationReason          String?                   @map("revocation_reason") @db.Text
  createdAt                 DateTime                  @default(now()) @map("created_at")
  updatedAt                 DateTime                  @updatedAt @map("updated_at")
  
  // Relations
  user                      User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  exchange                  Exchange?                 @relation(fields: [exchangeId], references: [id])
  dataKey                   DataKey                   @relation(fields: [dataKeyId], references: [id])
  auditLogs                 KeyAuditLog[]
  rotationHistory           KeyRotationHistory[]
  
  @@unique([userId, exchangeId])
  @@index([userId, isActive])
  @@index([validationStatus, nextRotation])
  @@index([riskScore])
  @@index([securityLevel])
  @@map("encrypted_api_credentials")
}

// Comprehensive audit logging for all key operations
model KeyAuditLog {
  id                String                @id @default(cuid())
  userId            String                @map("user_id")
  masterKeyId       String?               @map("master_key_id")
  credentialId      String?               @map("credential_id")
  operation         KeyOperation
  operationStatus   OperationStatus       @default(PENDING)
  riskLevel         RiskLevel             @default(LOW) @map("risk_level")
  riskFactors       String[]              @default([]) @map("risk_factors")
  riskScore         Decimal               @default(0) @map("risk_score") @db.Decimal(3, 2)
  ipAddress         String?               @map("ip_address") @db.VarChar(45)
  userAgent         String?               @map("user_agent") @db.Text
  deviceFingerprint String?               @map("device_fingerprint") @db.VarChar(500)
  geolocation       Json?                 @map("geolocation")
  sessionId         String?               @map("session_id") @db.VarChar(100)
  exchangeId        String?               @map("exchange_id")
  operationMetadata Json                  @default("{}") @map("operation_metadata")
  beforeState       Json?                 @map("before_state")
  afterState        Json?                 @map("after_state")
  errorDetails      String?               @map("error_details") @db.Text
  detectionRules    String[]              @default([]) @map("detection_rules")
  anomalyScore      Decimal?              @map("anomaly_score") @db.Decimal(3, 2)
  reviewRequired    Boolean               @default(false) @map("review_required")
  reviewedBy        String?               @map("reviewed_by")
  reviewedAt        DateTime?             @map("reviewed_at")
  reviewNotes       String?               @map("review_notes") @db.Text
  alertGenerated    Boolean               @default(false) @map("alert_generated")
  complianceFlags   String[]              @default([]) @map("compliance_flags")
  retentionPeriod   Int                   @default(31536000) @map("retention_period") // 1 year
  compressedAt      DateTime?             @map("compressed_at")
  createdAt         DateTime              @default(now()) @map("created_at")
  
  // Relations
  user              User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  masterKey         MasterKey?            @relation(fields: [masterKeyId], references: [id])
  credential        EncryptedApiCredential? @relation(fields: [credentialId], references: [id])
  
  @@index([userId, createdAt])
  @@index([operation, operationStatus])
  @@index([riskLevel, createdAt])
  @@index([anomalyScore, createdAt])
  @@index([reviewRequired])
  @@index([compressedAt])
  @@map("key_audit_logs")
}

// Key rotation history and lifecycle management
model KeyRotationHistory {
  id                    String              @id @default(cuid())
  masterKeyId           String?             @map("master_key_id")
  credentialId          String?             @map("credential_id")
  rotationType          RotationType
  rotationReason        RotationReason      @default(SCHEDULED)
  oldKeyVersion         Int?                @map("old_key_version")
  newKeyVersion         Int?                @map("new_key_version")
  oldKeyId              String?             @map("old_key_id") @db.VarChar(100)
  newKeyId              String?             @map("new_key_id") @db.VarChar(100)
  rotationStatus        RotationStatus      @default(INITIATED)
  initiatedBy           String              @map("initiated_by")
  completedBy           String?             @map("completed_by")
  gracePeriodEnd        DateTime?           @map("grace_period_end")
  backwardCompatible    Boolean             @default(true) @map("backward_compatible")
  rollbackCapable       Boolean             @default(true) @map("rollback_capable")
  rollbackDeadline      DateTime?           @map("rollback_deadline")
  validationSteps       Json                @default("[]") @map("validation_steps")
  migrationProgress     Decimal             @default(0) @map("migration_progress") @db.Decimal(3, 2)
  affectedResources     String[]            @default([]) @map("affected_resources")
  errorDetails          String?             @map("error_details") @db.Text
  performanceMetrics    Json                @default("{}") @map("performance_metrics")
  rollbackData          Json?               @map("rollback_data")
  initiatedAt           DateTime            @default(now()) @map("initiated_at")
  completedAt           DateTime?           @map("completed_at")
  rolledBackAt          DateTime?           @map("rolled_back_at")
  
  // Relations
  masterKey             MasterKey?          @relation(fields: [masterKeyId], references: [id])
  credential            EncryptedApiCredential? @relation(fields: [credentialId], references: [id])
  
  @@index([masterKeyId, initiatedAt])
  @@index([credentialId, initiatedAt])
  @@index([rotationStatus, gracePeriodEnd])
  @@index([rollbackCapable, rollbackDeadline])
  @@map("key_rotation_history")
}

