{
  "name": "crypto-portfolio-backend",
  "version": "1.0.0",
  "description": "Backend API for crypto portfolio management application",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && tsc-alias",
    "start": "node dist/index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:api": "jest --testPathPattern=tests/api",
    "test:integration": "jest --testPathPattern=tests/integration",
    "test:performance": "jest --testPathPattern=tests/performance",
    "test:security": "jest --testPathPattern=tests/security",
    "test:unit": "jest --testPathPattern=tests/unit",
    "test:e2e": "jest --testPathPattern=tests/integration --runInBand",
    "test:load": "artillery run tests/load/load-test.yml",
    "test:stress": "artillery run tests/load/stress-test.yml",
    "test:smoke": "jest --testPathPattern='(health|auth)' --testTimeout=5000",
    "test:regression": "jest --testPathPattern=tests --runInBand --coverage",
    "test:ci": "jest --ci --coverage --watchAll=false --runInBand",
    "test:debug": "jest --runInBand --verbose --detectOpenHandles",
    "test:report": "jest --coverage --coverageReporters=html --coverageReporters=text-lcov",
    "mock:server": "tsx src/mocks/mockApiServer.ts",
    "mock:start": "tsx -e 'import { mockApiServer } from \"./src/mocks/mockApiServer\"; mockApiServer.start(3002)'",
    "docs:serve": "tsx -e 'console.log(\"📚 API Documentation available at http://localhost:3001/api/v1/docs\")'",
    "docs:generate": "swagger-jsdoc -d src/docs/swagger.config.ts src/routes/**/*.ts -o docs/openapi.json",
    "docs:validate": "swagger-codegen validate -i docs/openapi.json",
    "docs:export": "tsx scripts/exportDocs.ts",
    "security:scan": "npm audit && npm audit fix",
    "security:test": "jest --testPathPattern=tests/security",
    "performance:benchmark": "jest --testPathPattern=tests/performance --detectOpenHandles",
    "performance:profile": "node --prof dist/index.js",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "typecheck": "tsc --noEmit",
    "validate": "npm run typecheck && npm run lint && npm run test:smoke",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:reset": "prisma migrate reset",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "worker": "tsx src/workers/index.ts",
    "scheduler": "tsx src/scheduler/index.ts",
    "queue:dashboard": "open http://localhost:3001/api/v1/queues/dashboard",
    "queue:clean": "tsx scripts/cleanQueues.ts",
    "postinstall": "prisma generate",
    "prestart": "npm run build",
    "pretest": "npm run typecheck",
    "local": "chmod +x scripts/start-local.sh && ./scripts/start-local.sh",
    "setup:local": "npm install && npm run db:generate && npm run db:migrate",
    "start:local": "./scripts/start-local.sh"
  },
  "dependencies": {
    "@prisma/client": "^5.7.0",
    "@sentry/node": "^7.120.4",
    "@slack/web-api": "^6.13.0",
    "@socket.io/redis-adapter": "^8.2.1",
    "@types/bull": "^3.15.9",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/uuid": "^10.0.0",
    "archiver": "^6.0.1",
    "aws-sdk": "^2.1692.0",
    "axios": "^1.6.2",
    "bcryptjs": "^2.4.3",
    "bull": "^4.16.5",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-async-errors": "^3.1.1",
    "express-prometheus-middleware": "^1.2.0",
    "express-rate-limit": "^7.1.5",
    "express-session": "^1.18.2",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.2",
    "lru-cache": "^10.1.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "node-stream-zip": "^1.15.0",
    "nodemailer": "^7.0.5",
    "passport": "^0.7.0",
    "passport-github2": "^0.1.12",
    "passport-google-oauth20": "^2.0.0",
    "pdfkit": "^0.14.0",
    "pg": "^8.12.0",
    "prisma": "^5.7.0",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4",
    "rate-limiter-flexible": "^7.2.0",
    "redis": "^4.6.11",
    "sharp": "^0.33.5",
    "socket.io": "^4.7.2",
    "speakeasy": "^2.0.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^11.1.0",
    "winston": "^3.17.0",
    "winston-elasticsearch": "^0.17.4",
    "ws": "^8.14.2",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@faker-js/faker": "^9.9.0",
    "@types/archiver": "^6.0.2",
    "@types/aws-sdk": "^2.7.4",
    "@types/bcryptjs": "^2.4.6",
    "@types/chai": "^4.3.11",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.18.2",
    "@types/jest": "^29.5.8",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/mocha": "^10.0.6",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.13",
    "@types/node": "^20.10.0",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^6.4.17",
    "@types/passport": "^1.0.17",
    "@types/passport-github2": "^1.2.9",
    "@types/passport-google-oauth20": "^2.0.16",
    "@types/pdfkit": "^0.13.4",
    "@types/pg": "^8.11.0",
    "@types/qrcode": "^1.5.5",
    "@types/sharp": "^0.32.0",
    "@types/sinon": "^17.0.2",
    "@types/socket.io": "^3.0.2",
    "@types/speakeasy": "^2.0.10",
    "@types/supertest": "^2.0.16",
    "@types/ws": "^8.5.10",
    "@typescript-eslint/eslint-plugin": "^6.12.0",
    "@typescript-eslint/parser": "^6.12.0",
    "artillery": "^2.0.21",
    "chai": "^4.3.10",
    "eslint": "^8.54.0",
    "jest": "^29.7.0",
    "jest-html-reporter": "^4.3.0",
    "mocha": "^10.2.0",
    "newman": "^6.2.1",
    "sinon": "^17.0.1",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.1",
    "tsc-alias": "^1.8.8",
    "tsx": "^4.6.0",
    "typescript": "^5.3.2"
  }
}
